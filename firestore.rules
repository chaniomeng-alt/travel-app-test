rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }
    function willOwn() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
    function membersOk() {
      return request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      allow read: if isOwner() || isMember();
      allow create: if willOwn() && membersOk();
      allow update: if (isOwner() || isMember())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && membersOk();
      allow delete: if isOwner();
    }
  }
}
